# --------------------------------------------------------------------------
# ALMA STUDIO — variables d'environnement
#
# Copier ce fichier en `.env.local` et renseigner les valeurs.
# Aucune de ces valeurs ne doit être commitée. Seules les variables
# préfixées `NEXT_PUBLIC_` sont exposées au navigateur : n'y placer jamais
# de secret.
# --------------------------------------------------------------------------

# URL publique du site — metadata, Open Graph, sitemap, liens des emails.
NEXT_PUBLIC_SITE_URL="https://alma-studio.fr"

# --- Supabase -------------------------------------------------------------
# Sans ces variables, le site fonctionne en mode démonstration : le
# catalogue provient de `config/seed.ts` et la réservation est indisponible.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SECRET — contourne les politiques RLS. Serveur uniquement.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Stripe ---------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# SECRET
STRIPE_SECRET_KEY=""
# SECRET — signature des webhooks. Fourni par `stripe listen` ou le tableau
# de bord Stripe. Sans lui, aucun paiement n'est jamais confirmé.
STRIPE_WEBHOOK_SECRET=""

# --- Emails (Resend) ------------------------------------------------------
# SECRET
RESEND_API_KEY=""
# Expéditeur vérifié dans Resend.
EMAIL_FROM="ALMA STUDIO <bonjour@alma-studio.fr>"

# --- SMS (facultatif) -----------------------------------------------------
# `twilio` ou `none`. L'envoi reste également conditionné au réglage
# `sms_enabled` de la table `settings`.
SMS_PROVIDER="none"
TWILIO_ACCOUNT_SID=""
# SECRET
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- Tâches planifiées ----------------------------------------------------
# SECRET — protège /api/cron/*. Vercel l'envoie automatiquement en en-tête
# `Authorization: Bearer …` lorsqu'il est défini sur le projet.
CRON_SECRET=""

# --- Mesure d'audience (facultatif) ---------------------------------------
# `plausible`, `ga` ou `none`. Rien n'est chargé sans consentement.
NEXT_PUBLIC_ANALYTICS_PROVIDER="none"
NEXT_PUBLIC_ANALYTICS_DOMAIN=""
NEXT_PUBLIC_ANALYTICS_ID=""
